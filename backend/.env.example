OPENVOICE_ENVIRONMENT=development
OPENVOICE_GIT_SHA=unknown
OPENVOICE_MODEL_ARTIFACT_DIR=model-artifacts
OPENVOICE_GENERATED_AUDIO_DIR=artifacts/audio
OPENVOICE_DEFAULT_MODEL_ID=kokoro
OPENVOICE_DEFAULT_MODEL_DISPLAY_NAME=Kokoro
OPENVOICE_DEFAULT_VOICE_ID=af_heart
OPENVOICE_KOKORO_MODEL_FILENAME=kokoro-v1.0.onnx
OPENVOICE_KOKORO_VOICES_FILENAME=voices-v1.0.bin
OPENVOICE_KOKORO_MODEL_VERSION=1.0
OPENVOICE_KOKORO_LANGUAGE=en-us
OPENVOICE_KOKORO_SPEED=1.0
OPENVOICE_AUDIO_URL_PREFIX=/audio
OPENVOICE_PRODUCT_MAXIMUM_CACHED_MODELS=2
OPENVOICE_PRODUCT_CPU_THREADS=2
OPENVOICE_SCHEDULER_AGING_THRESHOLD_SECONDS=30
OPENVOICE_SCHEDULER_QUEUE_CAPACITY=32
OPENVOICE_SCHEDULER_MAXIMUM_PAYLOAD_BYTES=160000
OPENVOICE_SCHEDULER_QUEUE_WAIT_TIMEOUT_SECONDS=300
OPENVOICE_SCHEDULER_MAXIMUM_ACTIVE_JOBS=4
# Optional hard-budget overrides for local testing:
# OPENVOICE_SCHEDULER_MEMORY_LIMIT_MB=8192
# OPENVOICE_SCHEDULER_CPU_LIMIT_CORES=4
# OPENVOICE_SCHEDULER_MEMORY_HEADROOM_MB=1536
